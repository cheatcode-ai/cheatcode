{
  "$schema": "./node_modules/knip/schema.json",
  // The shared compiler config is loaded through tsconfig `extends` paths.
  // `cloudflare:workers` and `cloudflare:workflows` are platform modules, not
  // installable package dependencies. Knip cannot infer either edge.
  "ignoreDependencies": ["@cheatcode/tsconfig", "cloudflare"],
  // Copied into the generated Next scaffold by the sandbox Dockerfile.
  "ignore": ["infra/containers/sandbox/app-templates/next/next.config.ts"],
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      // Skill TypeScript files are executable snapshot entrypoints discovered by
      // `cheatcode-skills`; the container scripts are invoked by the sandbox image.
      // These edges sit outside the pnpm workspace graph.
      "entry": [
        "skills/**/*.ts",
        "infra/containers/sandbox/scripts/configure-expo-runtime.mjs",
        "infra/containers/sandbox/scripts/pnpm-build-policy.mjs"
      ]
    },
    "infra/containers/sandbox/app-templates/expo": {
      // Expo Router loads these default exports by filesystem convention after the
      // Docker image copies this reviewed scaffold into a user workspace. The extra
      // Expo modules form the preinstalled mobile-builder palette consumed by generated
      // user code, so the minimal starter route intentionally does not import them.
      "entry": ["src/app/*.tsx"],
      "includeEntryExports": false,
      // Expo CLI is invoked by package scripts rather than imported by source.
      "ignoreBinaries": ["expo"],
      "ignoreDependencies": [
        "@expo/metro-runtime",
        "@expo/ui",
        "@types/react",
        "expo-constants",
        "expo-device",
        "expo-font",
        "expo-glass-effect",
        "expo-image",
        "expo-linking",
        "expo-splash-screen",
        "expo-symbols",
        "expo-updates",
        "expo-web-browser",
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-web",
        "react-native-worklets"
      ]
    },
    "apps/agent-worker": {
      // Wrangler reaches the platform module through its `alias` deployment
      // configuration, which is intentionally outside TypeScript's import graph.
      "entry": ["src/platform/execa-unavailable.ts"],
      "includeEntryExports": false
    },
    "packages/db": {
      "drizzle": {
        "config": []
      },
      "entry": ["drizzle.config.ts"],
      // Drizzle Kit loads this default export through its config convention.
      "ignoreIssues": {
        "drizzle.config.ts": ["exports"]
      }
    },
    "infra/containers/sandbox/browser-driver": {
      // This npm-lockfile workspace is installed only inside the sandbox image,
      // never in CI, so Knip cannot resolve its deps there. Locally-installed
      // node_modules make these ignores look redundant — they are not.
      "ignoreDependencies": ["playwright-core", "zod"]
    },
    "infra/containers/sandbox/skill-runtime": {
      "entry": ["bin/*.mjs"],
      // Public helpers are documented for user-authored sandbox skills and have
      // out-of-repo consumers that Knip cannot discover.
      "includeEntryExports": false,
      // Same in-image-only install: agent-browser and tsx resolve purely by
      // installed binary path at sandbox runtime, invisible to CI.
      "ignoreBinaries": ["agent-browser"],
      "ignoreDependencies": ["agent-browser", "tsx"]
    }
  }
}
