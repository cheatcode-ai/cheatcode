{
  "expo": {
    "name": "Cheatcode app",
    "slug": "cheatcode-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cheatcode",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
